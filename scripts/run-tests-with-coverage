#!/usr/bin/env bash
# Запускает тесты и сохраняет HTML-отчёт о покрытии в tests/coverage-report.
set -euo pipefail

project_directory="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$project_directory"

dotnet tool restore --tool-manifest dotnet-tools.json
results_directory="tests/coverage/$(date +%s)-$$"
dotnet test --settings tests/tests.runsettings --collect "XPlat Code Coverage" --results-directory "$results_directory"
dotnet tool run reportgenerator "-reports:$results_directory/**/coverage.cobertura.xml" \
    "-targetdir:tests/coverage-report" "-reporttypes:Html;Cobertura;JsonSummary"
